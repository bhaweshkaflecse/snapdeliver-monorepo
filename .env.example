# ==============================================================================
# SnapDeliver Environment Variables
# Copy this file to .env and fill in the values
# ==============================================================================

# --- Supabase Configuration ---
# Supabase project URL
SUPABASE_URL=
# Supabase anonymous (public) key for client-side access
SUPABASE_ANON_KEY=
# Supabase service role key for server-side operations (keep secret)
SUPABASE_SERVICE_KEY=

# --- Database ---
# PostgreSQL connection string (with pgvector extension enabled)
DATABASE_URL=

# --- Cloudflare R2 (S3-compatible storage) ---
# R2 account identifier
R2_ACCOUNT_ID=
# R2 access key ID for API authentication
R2_ACCESS_KEY_ID=
# R2 secret access key for API authentication
R2_SECRET_ACCESS_KEY=
# R2 bucket name for photo storage
R2_BUCKET_NAME=
# Public URL prefix for R2 bucket (via custom domain or R2.dev)
R2_PUBLIC_URL=

# --- Redis / BullMQ ---
# Full Redis connection URL (redis://user:pass@host:port)
REDIS_URL=
# Redis host (used by some services individually)
REDIS_HOST=
# Redis port
REDIS_PORT=6379

# --- Public URLs (exposed to browser/client) ---
# API base URL for client requests
NEXT_PUBLIC_API_URL=
# Supabase URL for client-side auth
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anonymous key for client-side auth
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Worker / Processing ---
# Default watermark text applied to preview images
WATERMARK_TEXT=
# Path to InsightFace model files for face recognition
INSIGHTFACE_MODEL_PATH=

# --- Application Settings ---
# Node environment (development, production, test)
NODE_ENV=development
# Port for the API server
API_PORT=3000
# Port for the worker health check server
WORKER_PORT=3002
# Port for the web application
WEB_PORT=3001
# Log level (debug, info, warn, error)
LOG_LEVEL=info
# JWT secret for API token signing (generate a random value)
JWT_SECRET=

# --- API Security ---
# Comma-separated list of allowed CORS origins (e.g., https://app.snapdeliver.com,https://portal.snapdeliver.com)
# In development, defaults to http://localhost:3000,http://localhost:3001 if not set
CORS_ALLOWED_ORIGINS=
# API key secret for authenticating desktop app upload requests (generate a random value)
API_KEY_SECRET=
